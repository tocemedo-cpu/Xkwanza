# Base de dados
# Nunca colocar aqui uma password real — este ficheiro é um modelo commitado no repositório.
# Local: postgresql://xkwanza:xkwanza@localhost:5432/xkwanza?schema=public
# Supabase: define os valores reais nas variáveis de ambiente do Render (ou no teu .env local, nunca aqui).
#   DATABASE_URL — ligação via pooler (porta 6543, pgbouncer), usada pela app em runtime.
#     postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
#   DIRECT_URL — ligação directa (porta 5432), usada só pelo `prisma migrate deploy`.
#     postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL="postgresql://user:password@host:6543/database?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/database"

# Servidor
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# JWT — gerar segredos fortes e distintos em produção (nunca reutilizar, nunca commitar)
JWT_ACCESS_SECRET="replace-with-a-strong-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-strong-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Segurança
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# INSS — nunca apontar para uma API oficial real sem acordo institucional formal
INSS_ADAPTER_MODE="sandbox"
