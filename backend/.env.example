# Base de dados
DATABASE_URL="postgresql://xkwanza:xkwanza@localhost:5432/xkwanza?schema=public"

# Servidor
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# JWT — gerar segredos fortes e distintos em produção (nunca reutilizar, nunca commitar)
JWT_ACCESS_SECRET="replace-with-a-strong-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-strong-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Segurança
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# INSS — nunca apontar para uma API oficial real sem acordo institucional formal
INSS_ADAPTER_MODE="sandbox"
